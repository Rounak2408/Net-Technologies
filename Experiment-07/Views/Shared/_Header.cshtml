@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-navy shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Feedback" asp-action="Index">
                <div class="brand-icon-wrapper me-2">
                    <i class="bi bi-chat-square-quote-fill"></i>
                </div>
                <div class="d-flex flex-column">
                    <span class="brand-title">FeedbackHub</span>
                    <span class="brand-subtitle">Student & Institutional Feedback Portal</span>
                </div>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#feedbackNavbar" aria-controls="feedbackNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="feedbackNavbar">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-1">
                    <li class="nav-item">
                        <a class="nav-link px-3 @(currentController == "Feedback" && currentAction == "Index" ? "active" : "")" asp-controller="Feedback" asp-action="Index">
                            <i class="bi bi-house-door me-1"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3 @(currentController == "Feedback" && currentAction == "List" ? "active" : "")" asp-controller="Feedback" asp-action="List">
                            <i class="bi bi-collection me-1"></i> View Feedback
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn btn-accent px-4 py-2 rounded-pill @(currentController == "Feedback" && currentAction == "Create" ? "active-btn" : "")" asp-controller="Feedback" asp-action="Create">
                            <i class="bi bi-plus-circle me-1"></i> Submit Feedback
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
